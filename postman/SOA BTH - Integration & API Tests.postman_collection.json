    {
      "name": "04 - CRUD Orders",
      "item": [
        {
          "name": "07 POST tạo đơn hàng - lưu orderId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "",
                  "const o = pm.response.json();",
                  "pm.test('Đơn hàng có id, pending, items', () => {",
                  "  pm.expect(o.id).to.be.a('number'); pm.expect(o.status).to.eql('pending'); pm.expect(o.items).to.be.an('array').with.lengthOf(1);",
                  "});",
                  "pm.test('Tổng tiền đúng', () => pm.expect(Number(o.totalAmount)).to.eql(Number(pm.collectionVariables.get('productPrice')) * 2));",
                  "if (o.id) pm.collectionVariables.set('orderId', String(o.id));",
                  "if (o.items?.[0]?.id) pm.collectionVariables.set('baseItemId', String(o.items[0].id));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
