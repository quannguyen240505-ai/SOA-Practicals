    "description": "Chạy Collection Runner theo thứ tự. Cần BTH2 8080, Product 8081, Order 8082. Đặt loginUserName và loginPassword trong Environment. Token được lấy từ /login; productId chọn từ /products; orderId/itemId tự lưu. Lưu ý: mã hiện tại chỉ KIỂM TRA tồn kho, KHÔNG TRỪ kho thực tế. Các test tạo đơn completed để lại dữ liệu demo. Không chạy trên database production.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "58441890",
    "_collection_link": "https://go.postman.co/collection/58441890-4b960ea0-965f-47cf-a1d0-0c74f7ce78c1?source=collection_link"
  },
  "item": [
    {
      "name": "01 - Auth BTH2",
      "item": [
        {
          "name": "01 Login và lưu JWT",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const password = pm.environment.get('loginPassword');",
                  "if (!password) throw new Error('Hãy đặt loginPassword trong Postman Environment trước khi chạy');",
                  "// BTH2 nhận password được Base64 mã hóa trong JSON.",
                  "const encoded = CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(password));",
                  "pm.variables.set('loginPasswordBase64', encoded);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "",
                  "const j = pm.response.json();",
                  "pm.test('Response có JWT', () => pm.expect(j.token).to.be.a('string').and.not.empty);",
                  "if (j.token) pm.collectionVariables.set('jwtToken', j.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"{{loginUserName}}\",\n  \"password\": \"{{loginPasswordBase64}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{authBaseUrl}}/login",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "02 Kiểm tra JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Token hợp lệ', () => pm.expect(pm.response.json().valid).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{authBaseUrl}}/auth",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "auth"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Product BTH3",
      "item": [
        {
          "name": "03 Danh sách sản phẩm, tự chọn productId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "",
                  "const products = pm.response.json();",
                  "pm.test('Danh sách là mảng', () => pm.expect(products).to.be.an('array'));",
                  "const p = products.find(p => Number(p.id) === Number(pm.collectionVariables.get('productId')) && p.quantity >= 4) || products.find(p => p.quantity >= 4);",
                  "pm.test('Có sản phẩm tồn kho tối thiểu 4', () => pm.expect(p).to.exist);",
                  "if (p) {",
                  "  pm.collectionVariables.set('productId', String(p.id));",
                  "  pm.collectionVariables.set('productPrice', String(p.price));",
                  "  pm.collectionVariables.set('stock', String(p.quantity));",
                  "  pm.collectionVariables.set('insufficientQty', String(Number(p.quantity)+1));",
                  "  console.log('Sản phẩm dùng test:', p.id, p.name, 'tồn:', p.quantity);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{productBaseUrl}}/products",
              "host": [
                "{{productBaseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          },
          "response": []
        }
      ]
    },
